{
  "name": "Smart App — Randevu Otomasyonu",
  "nodes": [
    {
      "parameters": {
        "content": "## 🚀 Smart App — Randevu Otomasyonu v5\n\n**Sheets sütunları:** id · name · email · enquiry · status · dateTime · calendarEventId\n\n**Akış:**\n1. Randevu Alındı → Veriyi Formatla → E-postalar + Sheets kaydet\n2. Onay/Red Webhook → IF → Onayla/Reddet kolları\n3. Onayla: Takvime Ekle → Sunucuya Bildir (calendarEventId ile) → Sheets güncelle → Onay e-postası\n4. Reddet: Sunucuya Bildir → Sheets güncelle → Red e-postası\n5. İptal: İptal Webhook → Sheets güncelle\n\n**Önemli:** Sunucuya Onayla Bildir URL'i calendarEventId query param içerir\n\n**Kurulum:**\n- Gmail, Google Sheets, Google Calendar OAuth2 credential ekle\n- YOUR_ADMIN_EMAIL, YOUR_SHEET_ID değerlerini güncelle",
        "height": 420,
        "width": 480,
        "color": 5
      },
      "id": "sticky-setup-note",
      "name": "📋 Kurulum Notu",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-200, 60]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "appointments",
        "responseMode": "onReceived",
        "options": {
          "responseCode": 200,
          "responseData": "{ \"received\": true }"
        }
      },
      "id": "wh-booking",
      "name": "Randevu Alındı",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [280, 300],
      "webhookId": "smart-app-appointments"
    },

    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "f-id",
              "name": "id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "f-name",
              "name": "name",
              "value": "={{ $json.name }}",
              "type": "string"
            },
            {
              "id": "f-email",
              "name": "email",
              "value": "={{ $json.email }}",
              "type": "string"
            },
            {
              "id": "f-enquiry",
              "name": "enquiry",
              "value": "={{ $json.enquiry }}",
              "type": "string"
            },
            {
              "id": "f-datetime",
              "name": "dateTime",
              "value": "={{ $json.dateTime }}",
              "type": "string"
            },
            {
              "id": "f-datetime-display",
              "name": "dateTimeDisplay",
              "value": "={{ new Intl.DateTimeFormat('tr-TR', {day:'numeric', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit', hour12:false, timeZone:'Europe/Istanbul'}).format(new Date($json.dateTime)) }}",
              "type": "string"
            },
            {
              "id": "f-status",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "f-approve-url",
              "name": "approveUrl",
              "value": "={{ $json.approveUrl }}",
              "type": "string"
            },
            {
              "id": "f-reject-url",
              "name": "rejectUrl",
              "value": "={{ $json.rejectUrl }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-format",
      "name": "Veriyi Formatla",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 300]
    },

    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=✅ Randevu Talebiniz Alındı — {{ $json.dateTimeDisplay }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'></head><body style='margin:0;padding:0;background:#f1f5f9;font-family:Inter,Arial,sans-serif'><table width='100%' cellpadding='0' cellspacing='0'><tr><td align='center' style='padding:32px 16px'><table width='600' cellpadding='0' cellspacing='0' style='background:white;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08)'><tr><td style='background:linear-gradient(135deg,#2563eb,#1d4ed8);padding:32px 40px;text-align:center'><h1 style='color:white;margin:0;font-size:24px;font-weight:700'>✅ Randevu Talebiniz Alındı</h1></td></tr><tr><td style='padding:32px 40px'><p style='color:#374151;font-size:16px;margin:0 0 24px'>Merhaba <strong>{{ $json.name }}</strong>,</p><p style='color:#374151;font-size:15px;line-height:1.6;margin:0 0 24px'>Randevu talebiniz sistemimize başarıyla kaydedildi. Talebiniz incelendikten sonra size onay veya bilgi e-postası gönderilecektir.</p><table width='100%' cellpadding='0' cellspacing='0' style='background:#f8fafc;border-radius:10px;overflow:hidden;margin:0 0 24px'><tr><td style='padding:12px 16px;background:#e0e7ff;font-weight:600;color:#3730a3;width:140px'>📅 Tarih &amp; Saat</td><td style='padding:12px 16px;color:#1e293b;font-weight:500'>{{ $json.dateTimeDisplay }}</td></tr><tr><td style='padding:12px 16px;font-weight:600;color:#374151'>📝 Talebiniz</td><td style='padding:12px 16px;color:#1e293b'>{{ $json.enquiry }}</td></tr></table><p style='color:#94a3b8;font-size:13px;margin:0'>Bu e-posta otomatik olarak gönderilmiştir.</p></td></tr></table></td></tr></table></body></html>",
        "options": {}
      },
      "id": "gm-user-receipt",
      "name": "Kullanıcıya Makbuz",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [760, 180],
      "credentials": {
        "gmailOAuth2": { "id": "GMAIL_CREDENTIAL_ID", "name": "Gmail OAuth2" }
      }
    },

    {
      "parameters": {
        "sendTo": "YOUR_ADMIN_EMAIL",
        "subject": "=🔔 Yeni Randevu Talebi — {{ $json.name }} ({{ $json.dateTimeDisplay }})",
        "emailType": "html",
        "message": "=<!DOCTYPE html><html><head><meta charset='utf-8'></head><body style='margin:0;padding:0;background:#f1f5f9;font-family:Inter,Arial,sans-serif'><table width='100%' cellpadding='0' cellspacing='0'><tr><td align='center' style='padding:32px 16px'><table width='600' cellpadding='0' cellspacing='0' style='background:white;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08)'><tr><td style='background:linear-gradient(135deg,#1e293b,#334155);padding:32px 40px;text-align:center'><h1 style='color:white;margin:0;font-size:22px;font-weight:700'>🔔 Yeni Randevu Talebi</h1></td></tr><tr><td style='padding:32px 40px'><table width='100%' cellpadding='0' cellspacing='0' style='background:#f8fafc;border-radius:10px;overflow:hidden;margin:0 0 28px'><tr><td style='padding:12px 16px;background:#f1f5f9;font-weight:600;color:#374151;width:120px'>Ad Soyad</td><td style='padding:12px 16px;color:#1e293b;font-weight:500'>{{ $json.name }}</td></tr><tr><td style='padding:12px 16px;font-weight:600;color:#374151'>E-posta</td><td style='padding:12px 16px;color:#2563eb'>{{ $json.email }}</td></tr><tr><td style='padding:12px 16px;background:#f1f5f9;font-weight:600;color:#374151'>Tarih &amp; Saat</td><td style='padding:12px 16px;color:#1e293b;font-weight:500'>{{ $json.dateTimeDisplay }}</td></tr><tr><td style='padding:12px 16px;font-weight:600;color:#374151;vertical-align:top'>Talep</td><td style='padding:12px 16px;color:#374151;line-height:1.6'>{{ $json.enquiry }}</td></tr><tr><td style='padding:12px 16px;background:#f1f5f9;font-weight:600;color:#374151'>Referans ID</td><td style='padding:12px 16px;color:#64748b;font-family:monospace;font-size:12px'>{{ $json.id }}</td></tr></table><table width='100%' cellpadding='0' cellspacing='0'><tr><td align='center'><a href='{{ $json.approveUrl }}' style='display:inline-block;background:#16a34a;color:white;padding:14px 36px;border-radius:10px;text-decoration:none;font-weight:700;font-size:15px;margin-right:12px'>✅ ONAYLA</a><a href='{{ $json.rejectUrl }}' style='display:inline-block;background:#dc2626;color:white;padding:14px 36px;border-radius:10px;text-decoration:none;font-weight:700;font-size:15px'>❌ REDDET</a></td></tr></table></td></tr></table></td></tr></table></body></html>",
        "options": {}
      },
      "id": "gm-admin-approval",
      "name": "Yöneticiye Onay İsteği",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [760, 420],
      "credentials": {
        "gmailOAuth2": { "id": "GMAIL_CREDENTIAL_ID", "name": "Gmail OAuth2" }
      }
    },

    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID", "mode": "id" },
        "sheetName":  { "__rl": true, "value": "Randevular", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id":              "={{ $json.id }}",
            "name":            "={{ $json.name }}",
            "email":           "={{ $json.email }}",
            "enquiry":         "={{ $json.enquiry }}",
            "status":          "pending",
            "dateTime":        "={{ $json.dateTime }}",
            "calendarEventId": ""
          }
        },
        "options": {}
      },
      "id": "gs-save",
      "name": "Google Sheets'e Kaydet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1000, 300],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GSHEETS_CREDENTIAL_ID", "name": "Google Sheets OAuth2" }
      }
    },

    {
      "parameters": {
        "httpMethod": "GET",
        "path": "randevu-onayla",
        "responseMode": "onReceived",
        "options": {
          "responseCode": 200,
          "responseData": "{ \"received\": true }"
        }
      },
      "id": "wh-approve",
      "name": "Onay/Red Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [280, 680],
      "webhookId": "smart-app-approve"
    },

    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-action",
              "leftValue": "={{ $json.query.action }}",
              "rightValue": "approve",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-action",
      "name": "Onayla mı Reddet mi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 680]
    },

    {
      "parameters": {
        "operation": "create",
        "calendar": { "__rl": true, "value": "primary", "mode": "id" },
        "start": "={{ $json.query.dateTime }}",
        "end":   "={{ new Date(new Date($json.query.dateTime).getTime() + 30*60*1000).toISOString() }}",
        "additionalFields": {
          "summary":      "=Randevu: {{ $json.query.name }}",
          "description":  "=Kişi: {{ $json.query.name }}\nE-posta: {{ $json.query.email }}\nTarih: {{ $json.query.dateTimeDisplay }}",
          "attendees":    "={{ $json.query.email.toString().trim() }}",
          "timeZone":     "Europe/Istanbul",
          "transparency": "opaque",
          "visibility":   "default"
        }
      },
      "id": "gcal-create",
      "name": "Takvime Ekle",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [760, 580],
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "GCAL_CREDENTIAL_ID", "name": "Google Calendar OAuth2" }
      }
    },

    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:3000/api/approval/approve/{{ $('Onay/Red Webhook').item.json.query.id }}?calendarEventId={{ $json.id }}",
        "options": {}
      },
      "id": "http-notify-approve",
      "name": "Sunucuya Onayla Bildir",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 580]
    },

    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID", "mode": "id" },
        "sheetName":  { "__rl": true, "value": "Randevular", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id":              "={{ $('Onay/Red Webhook').item.json.query.id }}",
            "status":          "approved",
            "calendarEventId": "={{ $('Takvime Ekle').item.json.id }}"
          },
          "matchingColumns": ["id"]
        },
        "options": {}
      },
      "id": "gs-update-approved",
      "name": "Sheets Onayla Güncelle",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1240, 580],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "GSHEETS_CREDENTIAL_ID", "name": "Google Sheets OAuth2" }
      }
