# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── AI Provider — openai | gemini | groq ────────────────────────────────────
AI_PROVIDER=groq

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gmail OAuth2 ─────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
ADMIN_EMAIL=

# ── Google Calendar OAuth2 ───────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# ── Booking ──────────────────────────────────────────────────────────────────
APPOINTMENT_DURATION_MINUTES=30
BOOKING_WINDOW_DAYS=5
TIMEZONE=Europe/Istanbul

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/smart-app
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/smart-app
MONGODB_URI=

# ── Admin Panel ──────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=
# JWT secret — generate with: openssl rand -hex 64
JWT_SECRET=

# ── CORS / Callback URLs ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:3000

# ── n8n Webhook URLs ─────────────────────────────────────────────────────────
# ngrok veya deploy ettiğin servisin public URL'ini buraya yaz
N8N_BASE=
N8N_WEBHOOK_URL=
N8N_APPROVAL_WEBHOOK_URL=
N8N_CANCELLATION_WEBHOOK_URL=
